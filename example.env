# example config for the app, actual file should be called .env and be located in root of the project
LEPTOS_SITE_ADDR=0.0.0.0:8080
LEPTOS_SITE_ROOT=site
LEPTOS_TAILWIND_VERSION=v4.1.14
DAISYUI_VERSION=latest

# Local PostgreSQL started automatically by the development container
# if change needed: the pattern is:
# DATABASE_URL=postgres://<user>:<password>@<host>:<port>/<db_name>
DATABASE_URL=postgres://postgres@127.0.0.1:5432/mywebpage
DB_MAX_CONNECTIONS=5
